// Активный 
let container = document.querySelector ('.page');
let popup = container.querySelector('.popup');
let introButton = container.querySelector ('.intro__button');
let formElement = container.querySelector('.popup__container') 
 
function popupActive () {
   popup.classList.add ('popup_active'); 

   let introName = container.querySelector('.intro__name');
   let introActivity = container.querySelector('.intro__activity');

   let popupInputName = container.querySelector('.popup__input-name');
   let popupInputActivity = container.querySelector('.popup__input-activity');

   popupInputName.setAttribute( 'value', introName.textContent);
   popupInputActivity.setAttribute( 'value', introActivity.textContent);
} 
 
introButton.addEventListener('click',popupActive); 

// Закрытый 
let closeButton = popup.querySelector ('.popup__form-button')

function closePopup () {
   popup.classList.remove ('popup_active'); 
}

closeButton.addEventListener('click',closeButton)


//Сохраним изменения 

let saveButton = container.querySelector('.popup__form-button')

let popupInputName = formElement.querySelector('.popup__input-name');
let popupInputActivity = formElement.querySelector('.popup__input-activity');

function handleFormSubmit (evt) {
    evt.preventDefault(); 
    let introName = container.querySelector('.intro__name');
    let introActivity = container.querySelector('.intro__activity');
    
    introName.textContent=popupInputName.value
    introActivity.textContent=popupInputActivity.value
    
    closePopup()
}

formElement.addEventListener('submit', handleFormSubmit);